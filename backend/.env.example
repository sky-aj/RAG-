# 复制成 .env 后再填。.env 不要提交到仓库。

# ---------- 主生成模型：sub-coco DeepSeek ----------
LLM_PROVIDER=sub-coco
LLM_BASE_URL=https://www.sub-coco.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-flash
# 用户提供的能力上限；不是每次请求的预算，平台上限仍需核验
LLM_MAX_OUTPUT_TOKENS=393216
LLM_MAX_TOKENS=8192
LLM_SUMMARY_MAX_TOKENS=1024
LLM_REWRITE_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
LLM_MIN_INTERVAL=0
LLM_EMIT_REASONING=true

# ---------- 备用生成模型：智谱 GLM，连接与预算独立 ----------
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=glm-4-flash
LLM_FALLBACK_MAX_TOKENS=8192
LLM_FALLBACK_TEMPERATURE=0.3

# ---------- 向量化（硅基流动 bge-m3，远程 API） ----------
# 不在本机跑推理，无需下载 2 GB 权重
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BACKEND=siliconflow
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# ---------- Qdrant ----------
# embedded：本地文件库，免 Docker；server：连 Qdrant 服务
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=corpus_chunks

# ---------- 检索 ----------
VECTOR_TOP_N=80
BM25_TOP_N=40
FUSION_TOP_K=12
SIMILARITY_THRESHOLD=0.35
RERANK_ENABLED=true
CONTEXT_TOKEN_BUDGET=6000
CHUNK_TARGET_TOKENS=320
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=40

# ---------- 查询改写（步骤 7，默认关闭） ----------
# 实测 A/B（4 条样本）：召回三项全平，相关性反而 -5.3pp，所以默认关。
# 复测脚本：backend/scripts/compare_step7.py
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_MAX_SUBQUERIES=3

# ---------- 服务 ----------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 标签文件留空时自动跟随 DOCUMENT_REGISTRY_PATH 的父目录
KNOWLEDGE_BASE_REGISTRY_PATH=

# ---------- 评测与追踪（步骤 7） ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=corpus-rag
EVAL_DATASET_MAX_TOKENS=2048
EVAL_GENERATION_MAX_TOKENS=8192
EVAL_JUDGE_MODEL=deepseek-v4-flash
EVAL_JUDGE_MAX_TOKENS=8192
